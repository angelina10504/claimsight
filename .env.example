# Copy to .env and fill in. .env is never committed.
# Every line must be on its own line: a glued line is read as one setting.

# ---------------------------------------------------------------- the models
# Which provider the CrewAI crews use: groq | ollama | anthropic
LLM_PROVIDER=groq

# Groq, reached through CrewAI's OpenAI provider (see src/config.py)
# The Groq model, and the OpenAI-compatible endpoint it is reached through.
# gpt-oss-120b is the default; gpt-oss-20b has its own daily allowance and is
# the fallback when the 120b one is spent. Changing this is an explicit choice,
# never automatic, and the model used is recorded in every run's log.
# gpt-oss-20b is the current default; set 120b for the evaluation, since it
# judges better and has its own separate daily allowance.
CLAIMSIGHT_GROQ_MODEL=openai/openai/gpt-oss-20b
CLAIMSIGHT_GROQ_VISION_MODEL=openai/qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GROQ_API_KEY=

# Gemini for the ADK claimant assistant, from aistudio.google.com/apikey
GOOGLE_API_KEY=
ADK_MODEL=gemini-2.5-flash

# Where the A2A server listens, and where the ADK agent looks for it
A2A_HOST=localhost
A2A_PORT=9999
CLAIMSIGHT_A2A_URL=http://localhost:9999

# ---------------------------------------------------------------- rate limits
# Attempts allowed per model call. The provider's own Retry-After wait is
# honoured by the client; this only decides how many times to wait it out.
CLAIMSIGHT_LLM_RETRIES=5
CLAIMSIGHT_LLM_TIMEOUT=180
# Requests per minute. The analysts still run in parallel; this spaces them.
CLAIMSIGHT_MAX_RPM=8
# Policy passages put in front of the Policy Analyst (CrewAI's default is 5)
CLAIMSIGHT_KNOWLEDGE_RESULTS=3

# ---------------------------------------------------------------- tracing
# Leave the keys blank to run with tracing off. cloud.langfuse.com is the EU
# host and the default; a US project needs us.cloud.langfuse.com, and a key
# from one region is refused by the other with a 401.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Traces carry prompts, so text is withheld unless this is true.
LANGFUSE_TRACE_CONTENT=false
# Set to 1 to keep every span in memory and send nothing. Tests set this
# themselves; you do not need it for normal runs.
# CLAIMSIGHT_OFFLINE=1

# ---------------------------------------------------------------- misc
# CrewAI's own telemetry. Left off: claim text should not leave the machine.
CREWAI_TRACING_ENABLED=false
# Local embeddings for the policy RAG
OLLAMA_BASE_URL=http://localhost:11434
# Set false to call the claim tools directly instead of over MCP
USE_MCP=true
