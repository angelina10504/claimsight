# ClaimSight dashboard (Streamlit) - the THIRD deployed service, alongside the
# CrewAI A2A server (./Dockerfile) and the ADK assistant (./Dockerfile.assistant).
#
# Build:  docker build -f Dockerfile.dashboard -t claimsight-dashboard .
# Run:    docker run --rm -p 8501:8501 claimsight-dashboard
# Open:   http://localhost:8501
#
# Presentation mode only in the cloud: it reads saved results and calls no
# model. No secret is needed or baked in. Do NOT give this service a
# GROQ_API_KEY: the dashboard's "Live assessment" mode would then let any
# visitor of the public URL start a real, token-spending Flow run.

# Same uv + Python 3.12 base and the same uv.lock as the other two images.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

# The dashboard, src/ (reporting, guardrails, vision's parts list), and the
# committed fixtures it reads: data/manifest.json, data/photo_manifest.json,
# data/claims, data/policies, data/invoices, data/assessment and the 11 claim
# photos. The shared .dockerignore keeps secrets, the VehiDE dataset and the
# runtime output folders (data/decisions, data/logs, ...) out.
COPY . .

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    CLAIMSIGHT_OFFLINE=1
RUN mkdir -p data/logs data/decisions data/review_queue data/intake data/evidence data/reports

# .streamlit/config.toml pins server.address to 127.0.0.1 for local use (and
# tests/test_dashboard.py asserts it stays that way). Command-line flags override the
# config file, so the container binds 0.0.0.0 on the platform's $PORT here
# without touching the local workflow. 8501 is Streamlit's usual default.
ENV DASHBOARD_PORT=8501
EXPOSE 8501
CMD ["sh", "-c", "exec streamlit run dashboard/app.py --server.address 0.0.0.0 --server.port \"${PORT:-$DASHBOARD_PORT}\" --server.headless true"]
