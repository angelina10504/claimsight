# ---------------------------------------------------------------- secrets
# Never commit these. The API keys for Groq, Gemini and Langfuse live here.
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------------------------------------------------------------- what runs produce
# These are written while a claim is assessed. They hold claim narratives,
# vehicle registrations and agent prompts, so they are runtime data rather than
# source, and they are regenerated by running a claim again.
data/decisions/
data/review_queue/
data/intake/
data/evidence/
data/logs/
data/reports/

# The synthetic dataset itself IS tracked on purpose: data/claims,
# data/policies, data/invoices and data/manifest.json are the fixtures every
# test selects from, so results can be reproduced.

# ---------------------------------------------------------------- local tooling
.DS_Store
.idea/
.vscode/
*.swp
server.log
*.local

# The CrewAI knowledge index is rebuilt from knowledge/policy_wording.txt and
# is stored outside the project, but ignore a local copy if one appears.
.chroma/
chroma/
db/

# dashboard: live-run locks, backups and the evidence sandbox
dashboard/.runtime/
